+    // wick: the firmware's version and release on macOS are those ioreg(8)
+    // shows, and a version without a major.minor release is refused.
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn test_macos_firmware_is_ioregs() {
+        let out = std::process::Command::new("/usr/sbin/ioreg")
+            .args(["-p", "IODeviceTree", "-r", "-n", "chosen", "-d", "1", "-l"])
+            .output()
+            .unwrap();
+        let text = String::from_utf8(out.stdout).unwrap();
+        let line = text
+            .lines()
+            .find(|l| l.contains("\"system-firmware-version\" = <\""))
+            .unwrap();
+        let shown = line.split("<\"").nth(1).unwrap().trim_end_matches("\">");
+        let version = read_sysfs_file("/sys/devices/virtual/dmi/id/bios_version").unwrap();
+        assert_eq!(version, shown);
+        let release = read_sysfs_file("/sys/devices/virtual/dmi/id/bios_release").unwrap();
+        assert!(version.contains(&format!("-{release}.")) || version.ends_with(&format!("-{release}")));
+        assert_eq!(
+            read_sysfs_file("/sys/devices/system/cpu/cpu0/regs/identification/revidr_el1").unwrap(),
+            "0x0000000000000000"
+        );
+        assert_eq!(firmware_release("mBoot-20457.41.3").unwrap(), "20457.41");
+        assert_eq!(firmware_release("iBoot-11881.1").unwrap(), "11881.1");
+        for bad in ["mBoot-20457", "mBoot-", "mBoot-a.b", ""] {
+            firmware_release(bad).unwrap_err();
+        }
+        iokit::data(c"IODeviceTree:/chosen", c"no-such-property").unwrap_err();
+        iokit::data(c"IODeviceTree:/no-such-node", c"system-firmware-version").unwrap_err();
+    }
+
     #[test]
     fn test_read_invalid_sysfs_file() {
         let invalid_sysfs_path = "/sys/invalid/path";
