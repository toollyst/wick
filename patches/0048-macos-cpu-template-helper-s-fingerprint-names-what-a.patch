+// wick: macOS has no sysfs; each file the fingerprint reads holds what it
+// tells of a guest's host, from macOS's sources. Any other path is not
+// found, as on Linux.
+// - revidr_el1: the host's REVIDR_EL1 cannot be read on macOS: it is an EL1
+//   register, no sysctl gives it, and Hypervisor.framework has no register
+//   for it (hv_vcpu_types.h lists MIDR_EL1 and MPIDR_EL1 of the ID
+//   registers). On Linux the file is also what a KVM guest reads, as KVM
+//   gives the guest the host's (Linux v6.1 arch/arm64/kvm/sys_regs.c,
+//   invariant_sys_regs); here it holds what every guest reads under
+//   Hypervisor.framework, 0 (tools/macos/boot-test.py `fingerprint` reads
+//   it in a guest), in Linux's format (arch/arm64/kernel/cpuinfo.c,
+//   "0x%016llx").
+// - bios_version: Apple silicon has no SMBIOS; the Mac's firmware version is
+//   IODeviceTree:/chosen's system-firmware-version ("mBoot-20457.41.3", the
+//   System Firmware Version System Information shows).
+// - bios_release: SMBIOS's BIOS release is the firmware's major.minor
+//   release ("%u.%u", drivers/firmware/dmi_scan.c); here that of the
+//   firmware version ("20457.41").
+#[cfg(target_os = "macos")]
+fn read_sysfs_file(path: &str) -> Result<String, FingerprintDumpError> {
+    let value = match path {
+        "/sys/devices/system/cpu/cpu0/regs/identification/revidr_el1" => {
+            Ok(format!("0x{:016x}", 0u64))
+        }
+        "/sys/devices/virtual/dmi/id/bios_version" => iokit::firmware_version(),
+        "/sys/devices/virtual/dmi/id/bios_release" => {
+            iokit::firmware_version().and_then(|version| firmware_release(&version))
+        }
+        _ => Err(std::io::ErrorKind::NotFound.into()),
+    };
+    value.map_err(|err| FingerprintDumpError::ReadSysfsFile(path.to_string(), err))
+}
+
+// wick: "<name>-<major>.<minor>[.<more>]" gives "<major>.<minor>".
+#[cfg(target_os = "macos")]
+fn firmware_release(version: &str) -> std::io::Result<String> {
+    let numbers = version.rsplit_once('-').map_or(version, |(_, n)| n);
+    let mut parts = numbers.split('.');
+    match (parts.next(), parts.next()) {
+        (Some(major), Some(minor))
+            if [major, minor]
+                .iter()
+                .all(|p| !p.is_empty() && p.bytes().all(|b| b.is_ascii_digit())) =>
+        {
+            Ok(format!("{major}.{minor}"))
+        }
+        _ => Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            format!("the firmware version {version:?} has no major.minor release"),
+        )),
+    }
+}
+
+// wick: a data property of an IORegistry entry, read through IOKit; a
+// missing entry or property is an error naming it.
+#[cfg(target_os = "macos")]
+mod iokit {
+    use std::ffi::{CStr, c_char, c_void};
+    use std::io;
+
+    type CFTypeRef = *const c_void;
+
+    #[link(name = "IOKit", kind = "framework")]
+    unsafe extern "C" {
+        fn IORegistryEntryFromPath(main_port: u32, path: *const c_char) -> u32;
+        fn IORegistryEntryCreateCFProperty(
+            entry: u32,
+            key: CFTypeRef,
+            allocator: CFTypeRef,
+            options: u32,
+        ) -> CFTypeRef;
+        fn IOObjectRelease(object: u32) -> i32;
+    }
+
+    #[link(name = "CoreFoundation", kind = "framework")]
+    unsafe extern "C" {
+        fn CFStringCreateWithCString(alloc: CFTypeRef, s: *const c_char, encoding: u32) -> CFTypeRef;
+        fn CFGetTypeID(cf: CFTypeRef) -> usize;
+        fn CFDataGetTypeID() -> usize;
+        fn CFDataGetLength(data: CFTypeRef) -> isize;
+        fn CFDataGetBytePtr(data: CFTypeRef) -> *const u8;
+        fn CFRelease(cf: CFTypeRef);
+    }
+
+    /// kCFStringEncodingUTF8.
+    const UTF8: u32 = 0x0800_0100;
+
+    pub fn data(path: &CStr, key: &CStr) -> io::Result<Vec<u8>> {
+        let missing = |what: &str| io::Error::new(io::ErrorKind::NotFound, format!("{what}: not found"));
+        // SAFETY: NUL-terminated strings; each object made here is released
+        // here, and the data's bytes are copied before it is.
+        unsafe {
+            // kIOMainPortDefault is MACH_PORT_NULL.
+            let entry = IORegistryEntryFromPath(0, path.as_ptr());
+            if entry == 0 {
+                return Err(missing(&path.to_string_lossy()));
+            }
+            let name = CFStringCreateWithCString(std::ptr::null(), key.as_ptr(), UTF8);
+            let value = if name.is_null() {
+                std::ptr::null()
+            } else {
+                IORegistryEntryCreateCFProperty(entry, name, std::ptr::null(), 0)
+            };
+            if !name.is_null() {
+                CFRelease(name);
+            }
+            IOObjectRelease(entry);
+            let what = format!("{} {}", path.to_string_lossy(), key.to_string_lossy());
+            if value.is_null() {
+                return Err(missing(&what));
+            }
+            let bytes = if CFGetTypeID(value) == CFDataGetTypeID() {
+                let len = usize::try_from(CFDataGetLength(value)).unwrap_or(0);
+                Ok(std::slice::from_raw_parts(CFDataGetBytePtr(value), len).to_vec())
+            } else {
+                Err(io::Error::new(io::ErrorKind::InvalidData, format!("{what}: not data")))
+            };
+            CFRelease(value);
+            bytes
+        }
+    }
+
+    /// IODeviceTree:/chosen's system-firmware-version, without its NULs.
+    pub fn firmware_version() -> io::Result<String> {
+        let bytes = data(c"IODeviceTree:/chosen", c"system-firmware-version")?;
+        let text = String::from_utf8_lossy(&bytes).trim_end_matches('\0').to_string();
+        if text.is_empty() || text.contains('\0') {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                format!("IODeviceTree:/chosen system-firmware-version: {bytes:?}"),
+            ));
+        }
+        Ok(text)
+    }
+}
+
 #[cfg(all(target_arch = "x86_64", windows))]
 fn get_microcode_version() -> Result<String, FingerprintDumpError> {
     // wick: the revision Windows read from the processor at boot, as Linux's
@@ -186,6 +322,38 @@ mod tests {
