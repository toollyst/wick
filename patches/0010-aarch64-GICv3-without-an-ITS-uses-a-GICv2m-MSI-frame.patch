+    // wick: the MSI SPI registers are the shared-irq ones above the wired SPIs.
+    #[test]
+    fn test_msi_spi_regs() {
+        let shared = VGIC_DIST_REGS
+            .iter()
+            .filter(|r| matches!(r, DistReg::SharedIrq(_)))
+            .count();
+        assert_eq!(shared, MSI_SPI_REGS);
+        let reg = DistReg::SharedIrq(SharedIrqReg {
+            offset: 0x0100,
+            bits_per_irq: 1,
+            irqs: (SPI_START + GSI_LEGACY_NUM, 892),
+        });
+        // ISENABLER for SPIs 128..1019: bytes 16..128, 28 words.
+        assert_eq!(reg.range(), 0x0110..0x0180);
+        assert_eq!(reg.iter::<u32>().count(), 28);
+    }
