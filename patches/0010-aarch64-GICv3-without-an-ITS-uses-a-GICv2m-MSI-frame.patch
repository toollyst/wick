 use crate::arch::aarch64::gic::regs::{GicState, GicVcpuState};
 
 /// Save the state of the GIC device.
+// wick: a GIC may have no ITS (Hypervisor.framework); it then has no ITS state.
 pub fn save_state(
     gic_device: &DeviceFd,
-    its_device: &DeviceFd,
+    its_device: Option<&DeviceFd>,
     mpidrs: &[u64],
 ) -> Result<GicState, GicError> {
     // Flush redistributors pending tables to guest RAM.
     super::save_pending_tables(gic_device)?;
     // Flush ITS tables into guest memory.
-    its_save_tables(its_device)?;
+    if let Some(its_device) = its_device {
+        its_save_tables(its_device)?;
+    }
 
     let mut vcpu_states = Vec::with_capacity(mpidrs.len());
     for mpidr in mpidrs {
@@ -31,23 +34,37 @@ pub fn save_state(
         })
     }
 
-    let its_state = ItsRegisterState::save(its_device)?;
+    let its_state = its_device.map(ItsRegisterState::save).transpose()?;
+
+    // wick: without an ITS, MSIs are SPIs above the wired ones; their
+    // distributor state follows the other registers.
+    let mut dist = dist_regs::get_dist_regs(gic_device)?;
+    if its_device.is_none() {
+        dist.extend(dist_regs::get_msi_spi_regs(gic_device)?);
+    }
 
     Ok(GicState {
-        dist: dist_regs::get_dist_regs(gic_device)?,
+        dist,
         gic_vcpu_states: vcpu_states,
-        its_state: Some(its_state),
+        its_state,
     })
 }
 
 /// Restore the state of the GIC device.
+// wick: the ITS is optional, as in `save_state`.
 pub fn restore_state(
     gic_device: &DeviceFd,
-    its_device: &DeviceFd,
+    its_device: Option<&DeviceFd>,
     mpidrs: &[u64],
     state: &GicState,
 ) -> Result<(), GicError> {
     dist_regs::set_dist_regs(gic_device, &state.dist)?;
+    // wick: the MSI SPIs saved by `save_state` for a GIC without an ITS.
+    if let Some(msi_spis) = state.dist.get(dist_regs::dist_regs_len()..)
+        && !msi_spis.is_empty()
+    {
+        dist_regs::set_msi_spi_regs(gic_device, msi_spis)?;
+    }
 
     if mpidrs.len() != state.gic_vcpu_states.len() {
         return Err(GicError::InconsistentVcpuCount);
@@ -57,11 +74,18 @@ pub fn restore_state(
         icc_regs::set_icc_regs(gic_device, *mpidr, &vcpu_state.icc)?;
     }
 
-    state
-        .its_state
-        .as_ref()
-        .ok_or(GicError::MissingItsState)?
-        .restore(its_device)
+    match (its_device, state.its_state.as_ref()) {
+        (Some(its_device), its_state) => its_state
+            .ok_or(GicError::MissingItsState)?
+            .restore(its_device),
+        (None, None) => Ok(()),
+        // ITS state, but no ITS to restore it to.
+        (None, Some(_)) => Err(GicError::DeviceAttribute(
+            kvm_ioctls::Error::new(libc::ENODEV),
+            true,
+            kvm_bindings::KVM_DEV_ARM_VGIC_GRP_CTRL,
+        )),
+    }
 }
 
