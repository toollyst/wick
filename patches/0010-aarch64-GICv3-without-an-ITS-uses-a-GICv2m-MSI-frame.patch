@@ -167,12 +178,46 @@ impl GICv3 {
         Ok(())
     }
 
+    // wick: places the MSI frame where the ITS would be, if the GIC has one.
+    // Returns its `reg` (address and size), or `None` for a GIC without one.
+    fn init_msi_frame(gic_device: &Self) -> Result<Option<[u64; 2]>, GicError> {
+        let attr = kvm_bindings::kvm_device_attr {
+            group: kvm_bindings::KVM_DEV_ARM_VGIC_GRP_ADDR,
+            attr: Self::ADDR_TYPE_MSI_FRAME,
+            addr: 0,
+            flags: 0,
+        };
+        if gic_device.device_fd().has_device_attr(&attr).is_err() {
+            return Ok(None);
+        }
+        let addr = Self::get_msi_address(gic_device.vcpu_count());
+        Self::set_device_attribute(
+            gic_device.device_fd(),
+            kvm_bindings::KVM_DEV_ARM_VGIC_GRP_ADDR,
+            Self::ADDR_TYPE_MSI_FRAME,
+            &addr as *const u64 as u64,
+            0,
+        )?;
+        Ok(Some([addr, Self::MSI_FRAME_SIZE]))
+    }
+
     /// Method to initialize the GIC device
     pub fn create(vm: &VmFd, vcpu_count: u64) -> Result<Self, GicError> {
         let mut device = Self::create_device(vm, vcpu_count)?;
 
         Self::init_device_attributes(&device)?;
-        Self::init_its(vm, &mut device)?;
+        // wick: the ITS is optional. Hypervisor.framework (macOS) has none;
+        // MSIs then go through its MSI frame, and without either no MSI
+        // controller is advertised to the guest. KVM has no MSI frame: on
+        // Linux a GIC without an ITS fails here, as it does upstream.
+        match Self::init_its(vm, &mut device) {
+            Err(GicError::CreateGIC(err))
+                if err.errno() == libc::ENODEV && cfg!(not(target_os = "linux")) =>
+            {
+                device.msi_properties = Self::init_msi_frame(&device)?
+            }
+            other => other?,
+        }
 
         Self::finalize_device(&device)?;
 
