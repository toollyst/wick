@@ -126,6 +133,73 @@ pub(crate) fn set_dist_regs(fd: &DeviceFd, state: &[GicRegState<u32>]) -> Result
     DistRegEngine::set_regs_data(fd, Box::new(VGIC_DIST_REGS.iter()), state, 0)
 }
 
+// wick: a GIC without an ITS signals MSIs as SPIs, through a GICv2m-style
+// MSI frame (Hypervisor.framework; see `GICv3::create`). They are the SPIs
+// above the wired ones, so their state is not in `VGIC_DIST_REGS`. These are
+// the same per-interrupt registers for them, up to the last SPI the
+// distributor implements (`GICD_TYPER.ITLinesNumber`, at most 1019).
+const GICD_TYPER: u64 = 0x0004;
+
+/// Number of entries `get_dist_regs` returns.
+pub(crate) fn dist_regs_len() -> usize {
+    VGIC_DIST_REGS.len()
+}
+
+/// Number of entries `get_msi_spi_regs` returns.
+#[cfg(test)]
+pub(crate) const MSI_SPI_REGS: usize = 10;
+
+fn msi_spi_regs(fd: &DeviceFd) -> Result<Vec<DistReg>, GicError> {
+    let mut typer = 0u32;
+    let mut attr = DistRegEngine::kvm_device_attr(GICD_TYPER, &mut typer, 0);
+    // SAFETY: `attr` points to `typer`, which outlives the call.
+    unsafe { fd.get_device_attr(&mut attr) }
+        .map_err(|err| GicError::DeviceAttribute(err, false, DistRegEngine::group()))?;
+    let end = (32 * ((typer & 0x1f) + 1)).min(1020);
+    let first = SPI_START + GSI_LEGACY_NUM;
+    let count = end.saturating_sub(first);
+    Ok(VGIC_DIST_REGS
+        .iter()
+        .filter_map(|reg| match reg {
+            DistReg::SharedIrq(reg) => Some(DistReg::SharedIrq(SharedIrqReg {
+                offset: reg.offset,
+                bits_per_irq: reg.bits_per_irq,
+                irqs: (first, count),
+            })),
+            DistReg::Simple(_) => None,
+        })
+        .collect())
+}
+
+// wick: see `msi_spi_regs`.
+pub(crate) fn get_msi_spi_regs(fd: &DeviceFd) -> Result<Vec<GicRegState<u32>>, GicError> {
+    msi_spi_regs(fd)?
+        .iter()
+        .map(|reg| DistRegEngine::get_reg_data(fd, reg, 0))
+        .collect()
+}
+
+// wick: see `msi_spi_regs`. The state must cover the same SPIs.
+pub(crate) fn set_msi_spi_regs(fd: &DeviceFd, state: &[GicRegState<u32>]) -> Result<(), GicError> {
+    let regs = msi_spi_regs(fd)?;
+    let fits = regs.len() == state.len()
+        && regs
+            .iter()
+            .zip(state)
+            .all(|(reg, s)| reg.iter::<u32>().count() == s.chunks.len());
+    if !fits {
+        return Err(GicError::DeviceAttribute(
+            kvm_ioctls::Error::new(libc::EINVAL),
+            true,
+            DistRegEngine::group(),
+        ));
+    }
+    for (reg, data) in regs.iter().zip(state) {
+        DistRegEngine::set_reg_data(fd, reg, data, 0)?;
+    }
+    Ok(())
+}
