@@ -336,7 +336,14 @@ fn create_gic_node(fdt: &mut FdtWriter, gic_device: &GICDevice) -> Result<(), Fd
 
     if let Some(msi_properties) = gic_device.msi_properties() {
         let msic_node = fdt.begin_node("msic")?;
-        fdt.property_string("compatible", "arm,gic-v3-its")?;
+        // wick: a GIC without an ITS has a GICv2m-style MSI frame
+        // (Hypervisor.framework); see `GICv3::create`.
+        let compatible = if gic_device.its_fd().is_some() {
+            "arm,gic-v3-its"
+        } else {
+            "arm,gic-v2m-frame"
+        };
+        fdt.property_string("compatible", compatible)?;
         fdt.property_null("msi-controller")?;
         fdt.property_u32("phandle", MSI_PHANDLE)?;
         fdt.property_array_u64("reg", msi_properties)?;
