index eca61afa2ff96849e0201fe9f4a2803d5afd8715..0f44a0d1a3716f3d98e5e02b4a70d6d8c63e6967 100644
--- a/src/snapshot-editor/src/edit_memory.rs
+++ b/src/snapshot-editor/src/edit_memory.rs
@@ -61,6 +61,9 @@ fn rebase(memory_path: PathBuf, diff_path: PathBuf) -> Result<(), EditMemoryErro
         .read(true)
         .open(diff_path)
         .map_err(EditMemoryError::OpenDiffFile)?;
+    // wick: on Windows only a sparse file has holes; any other would be copied whole.
+    #[cfg(windows)]
+    vmm_sys_util::seek_hole::holes_kept(&diff_file).map_err(EditMemoryError::OpenDiffFile)?;
 
     let mut cursor: u64 = 0;
     while let Some(block_start) = diff_file
