diff --git a/src/firecracker/src/main.rs b/src/firecracker/src/main.rs
index a92dbf32c7e0591a9d34513950da87d589c7bd52..b01b6506b1df2dc8700fad8fa75990782188550f 100644
--- a/src/firecracker/src/main.rs
+++ b/src/firecracker/src/main.rs
@@ -53,10 +53,12 @@ use crate::seccomp::SeccompConfig;
 // runtime file.
 // see https://refspecs.linuxfoundation.org/FHS_3.0/fhs/ch03s15.html for more information.
 const DEFAULT_API_SOCK_PATH: &str = "/run/firecracker.socket";
+// wick: the release label is wick's version, <upstream>-wick.<N> (crates/version);
+// `--snapshot-version` and the snapshot format stay upstream's.
 const FIRECRACKER_VERSION: &str = if cfg!(feature = "fuzzing") {
-    concat!(env!("CARGO_PKG_VERSION"), "+fuzzing")
+    concat!(wick_version::version!(), "+fuzzing") // wick: was CARGO_PKG_VERSION
 } else {
-    env!("CARGO_PKG_VERSION")
+    wick_version::version!() // wick: was CARGO_PKG_VERSION
 };
 const MMDS_CONTENT_ARG: &str = "metadata";
 
@@ -699,3 +701,30 @@ fn run_without_api(
     }
     Ok(())
 }
+
+// wick: the binary reports wick's version, built on this tree's upstream release.
+#[cfg(test)]
+mod wick_version_tests {
+    use super::*;
+
+    #[test]
+    #[cfg(not(feature = "fuzzing"))]
+    fn test_firecracker_version_is_upstream_plus_wick_number() {
+        // patches/base names the upstream release this Cargo.toml comes from.
+        assert_eq!(wick_version::UPSTREAM, env!("CARGO_PKG_VERSION"));
+        assert_eq!(
+            FIRECRACKER_VERSION,
+            format!(
+                "{}-wick.{}",
+                env!("CARGO_PKG_VERSION"),
+                wick_version::NUMBER
+            )
+        );
+        let version = semver::Version::parse(FIRECRACKER_VERSION).unwrap();
+        assert_eq!(
+            version.pre.as_str(),
+            format!("wick.{}", wick_version::NUMBER)
+        );
+        assert!(version.build.is_empty());
+    }
+}
