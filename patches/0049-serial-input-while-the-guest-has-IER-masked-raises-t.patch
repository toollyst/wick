index 88be201f7fa487406a639f0774c19b8901bc2fbe..97b5501a1d3459aa596a1a10a98da829458ddefb 100644
--- a/src/vmm/src/devices/legacy/serial.rs
+++ b/src/vmm/src/devices/legacy/serial.rs
@@ -483,6 +483,68 @@ mod tests {
         assert_eq!(invalid_reads_after_2, invalid_reads_after);
     }
 
+    // wick: a 16550's interrupt line is pending AND enabled, so input that arrives while the
+    // driver has IER masked raises the interrupt when IER comes back. Linux's 8250 console masks
+    // IER for every printk and relies on that (8250_port.c, serial8250_console_write); with
+    // vm-superio 0.8.1 such input stayed in the FIFO until the next byte came (a restored
+    // guest's "crng reseeded due to virtual machine fork" printk against the first command).
+    fn serial_with_interrupt() -> (SerialDevice, EventFdTrigger) {
+        let intr_evt = EventFdTrigger::new(EventFd::new(libc::EFD_NONBLOCK).unwrap());
+        let intr = intr_evt.try_clone().unwrap();
+        let serial = SerialDevice {
+            serial: Serial::with_events(
+                intr_evt,
+                SerialEventsWrapper {
+                    buffer_ready_event_fd: None,
+                },
+                test_serial_out_sink(),
+            ),
+            input: None::<std::io::Stdin>,
+        };
+        (serial, intr)
+    }
+
+    #[test]
+    fn test_input_while_ier_is_masked_is_signalled_when_ier_comes_back() {
+        const DATA: u64 = 0;
+        const IER: u64 = 1;
+        const IIR: u64 = 2;
+        const IER_RDI_RLSI: u8 = 0x05; // what the 8250 driver leaves in IER, read in CI's traces
+        let (mut serial, intr) = serial_with_interrupt();
+        serial.write(0, IER, &[IER_RDI_RLSI]);
+        // A printk: the console saves IER, clears it, writes, then restores it.
+        serial.write(0, IER, &[0]);
+        serial.serial.raw_input(b"x").unwrap();
+        assert!(intr.read().is_err(), "an interrupt while IER is masked");
+        serial.write(0, IER, &[IER_RDI_RLSI]);
+        assert_eq!(
+            intr.read().ok(),
+            Some(1),
+            "no interrupt for the waiting input"
+        );
+        let mut v = [0u8; 1];
+        serial.read(0, IIR, &mut v);
+        assert_eq!(v[0] & 0x0f, 0x04, "IIR does not name received data");
+        serial.read(0, DATA, &mut v);
+        assert_eq!(v[0], b'x');
+    }
+
+    // wick: and enabling the THR-empty interrupt raises it, the THR being always empty here, so
+    // Linux's start-up probe (8250_port.c, serial8250_do_startup) no longer marks the port
+    // UART_BUG_TXEN.
+    #[test]
+    fn test_enabling_the_thr_empty_interrupt_raises_it() {
+        const IER: u64 = 1;
+        const IIR: u64 = 2;
+        const IER_THRI: u8 = 0x02;
+        let (mut serial, intr) = serial_with_interrupt();
+        serial.write(0, IER, &[IER_THRI]);
+        assert_eq!(intr.read().ok(), Some(1), "no interrupt for the empty THR");
+        let mut v = [0u8; 1];
+        serial.read(0, IIR, &mut v);
+        assert_eq!(v[0] & 0x0f, 0x02, "IIR does not name the empty THR");
+    }
+
     #[test]
     fn test_restore_from_state() {
         let mut serial = SerialDevice::new(None, test_serial_out_sink(), None).unwrap();
