--- a/src/vmm/src/seccomp.rs
+++ b/src/vmm/src/seccomp.rs
@@ -76,6 +76,8 @@ pub enum InstallationError {
     FilterTooLarge,
     /// prctl` syscall failed with error code: {0}
     Prctl(std::io::Error),
+    /// {0}
+    Sandbox(crate::ext::sandbox::SandboxError), // wick: host sandbox where seccomp-BPF is unavailable
 }
 
 /// The maximum seccomp-BPF program length allowed by the linux kernel.
@@ -92,6 +94,13 @@ struct SockFprog {
 
 /// Apply bpf filter.
 pub fn apply_filter(bpf_filter: BpfProgramRef) -> Result<(), InstallationError> {
+    // wick: hosts without seccomp-BPF install their own sandbox (process-wide, once;
+    // selected from the seccomp configuration, see vmm::ext::sandbox). Their filters are
+    // empty; a non-empty BPF program fails below as on a kernel without seccomp filters.
+    if cfg!(not(target_os = "linux")) {
+        crate::ext::sandbox::apply().map_err(InstallationError::Sandbox)?;
+    }
+
     // If the program is empty, don't install the filter.
     if bpf_filter.is_empty() {
         return Ok(());
