             .and_then(|stream| stream.set_nonblocking(true).map(|_| stream))
             .map_err(VsockUnixBackendError::UnixConnect)
             .and_then(|stream| {
@@ -1199,6 +1203,53 @@ mod tests {
         assert_eq!(&buf, &data);
     }
 
+    // wick: a write after the host's close raises SIGPIPE, which upstream's handler counts, on
+    // a connection the host made and on one the guest asked for.
+    #[cfg(unix)]
+    #[test]
+    fn test_host_close_raises_sigpipe() {
+        for child in ["local_close_sigpipe_child", "peer_close_sigpipe_child"] {
+            crate::platform::socket::test_util::run_sigpipe_child(&format!(
+                "devices::virtio::vsock::unix::muxer::tests::{child}"
+            ));
+        }
+    }
+
+    // wick: a case of test_host_close_raises_sigpipe: the host's connection.
+    #[cfg(unix)]
+    #[test]
+    #[ignore = "run by test_host_close_raises_sigpipe in a separate process"]
+    fn local_close_sigpipe_child() {
+        let mut ctx = MuxerTestContext::new("local_close_sigpipe");
+        let peer_port = 1025;
+        let (stream, local_port) = ctx.local_connect(peer_port);
+        drop(stream);
+        crate::platform::socket::test_util::sigpipe_child(|| {
+            ctx.init_data_tx_pkt(local_port, peer_port, &[1, 2, 3, 4]);
+            ctx.send();
+        });
+    }
+
+    // wick: a case of test_host_close_raises_sigpipe: the guest's connection.
+    #[cfg(unix)]
+    #[test]
+    #[ignore = "run by test_host_close_raises_sigpipe in a separate process"]
+    fn peer_close_sigpipe_child() {
+        const LOCAL_PORT: u32 = 1026;
+        const PEER_PORT: u32 = 1025;
+        let mut ctx = MuxerTestContext::new("peer_close_sigpipe");
+        let mut listener = ctx.create_local_listener(LOCAL_PORT);
+        ctx.init_tx_pkt(LOCAL_PORT, PEER_PORT, uapi::VSOCK_OP_REQUEST);
+        ctx.send();
+        drop(listener.accept());
+        ctx.recv();
+        assert_eq!(ctx.rx_pkt.hdr.op(), uapi::VSOCK_OP_RESPONSE);
+        crate::platform::socket::test_util::sigpipe_child(|| {
+            ctx.init_data_tx_pkt(LOCAL_PORT, PEER_PORT, &[1, 2, 3, 4]);
+            ctx.send();
+        });
+    }
+
