From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=EC=8B=AC=EC=83=81=EC=9B=90?= <dev.chamomile@gmail.com>
Date: Fri, 13 Nov 2026 01:50:46 +0900
Subject: [PATCH] macos: the sockets Firecracker makes raise SIGPIPE as on
 Linux

Rust's standard library sets SO_NOSIGPIPE on every socket it makes on
Apple systems, and xnu copies it to accepted connections, so a write
after the peer's close failed with EPIPE and no SIGPIPE for upstream's
handler to count. The vsock device's listener and its connections to the
host's sockets, the connection to a page fault handler and the one to a
vhost-user backend now clear it (platform::socket::sigpipe_as_linux, a
no-op on Linux and Windows). Tests: a write after the host's or the
backend's close raises SIGPIPE, counted in signals.sigpipe.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/vmm/src/devices/virtio/vhost_user.rs      | 43 +++++++++++++++-
 .../src/devices/virtio/vsock/unix/muxer.rs    | 51 +++++++++++++++++++
 src/vmm/src/persist.rs                        |  4 +-
 3 files changed, 96 insertions(+), 2 deletions(-)

diff --git a/src/vmm/src/devices/virtio/vhost_user.rs b/src/vmm/src/devices/virtio/vhost_user.rs
index d65bef14d354ef3dca42d24ff2bbba3b4c833a69..52c9052fa823dbea03597e787575351319fd1354 100644
--- a/src/vmm/src/devices/virtio/vhost_user.rs
+++ b/src/vmm/src/devices/virtio/vhost_user.rs
@@ -283,7 +283,10 @@ impl<T: VhostUserHandleBackend> VhostUserHandleImpl<T> {
     /// Connect to the vhost-user backend socket and mark self as an
     /// owner of the session.
     pub fn new(socket_path: &str, num_queues: u64) -> Result<Self, VhostUserError> {
-        let stream = UnixStream::connect(socket_path).map_err(VhostUserError::Connect)?;
+        let stream = UnixStream::connect(socket_path)
+            // wick: SIGPIPE on a write after the backend's close, as on Linux.
+            .and_then(crate::platform::socket::sigpipe_as_linux)
+            .map_err(VhostUserError::Connect)?;
 
         let vu = T::from_stream(stream, num_queues);
         vu.set_owner().map_err(VhostUserError::VhostUserSetOwner)?;
@@ -545,6 +548,44 @@ pub(crate) mod tests {
         assert!(unsafe { *vuh.vu.is_owner.get() });
     }
 
+    // wick: a write after the backend's close raises SIGPIPE, counted as on Linux.
+    #[cfg(unix)]
+    #[test]
+    fn test_backend_close_raises_sigpipe() {
+        crate::platform::socket::test_util::run_sigpipe_child(
+            "devices::virtio::vhost_user::tests::backend_close_sigpipe_child",
+        );
+    }
+
+    // wick: the case of test_backend_close_raises_sigpipe.
+    #[cfg(unix)]
+    #[test]
+    #[ignore = "run by test_backend_close_raises_sigpipe in a separate process"]
+    fn backend_close_sigpipe_child() {
+        use std::io::Write;
+
+        struct MockFrontend {
+            sock: UnixStream,
+        }
+        impl VhostUserHandleBackend for MockFrontend {
+            fn from_stream(sock: UnixStream, _max_queue_num: u64) -> Self {
+                Self { sock }
+            }
+            fn set_owner(&self) -> Result<(), vhost::Error> {
+                Ok(())
+            }
+        }
+        let dir = vmm_sys_util::tempdir::TempDir::new().unwrap();
+        let path = dir.as_path().join("backend.sock");
+        let backend = std::os::unix::net::UnixListener::bind(&path).unwrap();
+        let vuh = VhostUserHandleImpl::<MockFrontend>::new(path.to_str().unwrap(), 1).unwrap();
+        drop(backend.accept().unwrap());
+        crate::platform::socket::test_util::sigpipe_child(|| {
+            let err = (&vuh.vu.sock).write_all(b"x").unwrap_err();
+            assert_eq!(err.raw_os_error(), Some(libc::EPIPE));
+        });
+    }
+
