         pub(crate) fn dev_null() -> Self {
             Self::new(std::fs::File::open("/dev/null").unwrap().into())
         }
+
+        /// wick: the error an ioctl on /dev/null fails with: ENOTTY on Linux, ENODEV on
+        /// macOS.
+        pub(crate) const DEV_NULL_IOCTL_ERRNO: i32 = if cfg!(target_os = "macos") {
+            libc::ENODEV
+        } else {
+            libc::ENOTTY
+        };
     }
 
     #[test]
@@ -1043,6 +1051,7 @@ mod tests {
         let err = EnclaveFd::dev_null()
             .update_device_config(1, 1, &[0; NE_UPDATE_CONFIG_MAX_SIZE - 1])
             .unwrap_err();
-        assert_eq!(err.raw_os_error(), Some(libc::ENOTTY));
+        // wick: the host's /dev/null ioctl error.
+        assert_eq!(err.raw_os_error(), Some(EnclaveFd::DEV_NULL_IOCTL_ERRNO));
     }
 }
