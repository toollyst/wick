         let state = original_dev.save();
+        // wick: Hypervisor.framework allows one VM per process; keep what is compared and
+        // free the original VM before creating the new one.
+        let (config, slot_size, avail_features, acked_features) = (
+            original_dev.config,
+            original_dev.slot_size,
+            original_dev.avail_features(),
+            original_dev.acked_features(),
+        );
+        drop(original_dev);
 
         // Create a "new" VM for restore
         let vm = setup_vm_with_memory(0x1000);
@@ -139,9 +148,9 @@ mod tests {
         let constructor_args = VirtioMemConstructorArgs::new(vm);
         let restored_dev = VirtioMem::restore(constructor_args, &state).unwrap();
 
-        assert_eq!(original_dev.config, restored_dev.config);
-        assert_eq!(original_dev.slot_size, restored_dev.slot_size);
-        assert_eq!(original_dev.avail_features(), restored_dev.avail_features());
-        assert_eq!(original_dev.acked_features(), restored_dev.acked_features());
+        assert_eq!(config, restored_dev.config);
+        assert_eq!(slot_size, restored_dev.slot_size);
+        assert_eq!(avail_features, restored_dev.avail_features());
+        assert_eq!(acked_features, restored_dev.acked_features());
     }
