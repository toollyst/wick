 #[cfg(target_os = "linux")] // wick: as above
 use std::process::{Command, Stdio};
-use std::process::{exit, id};
+use std::process::id;
+#[cfg(target_os = "linux")] // wick: daemonize's; macOS's is platform::daemonize
