+// wick: daemonize's; macOS's is platform::daemonize.
+#[cfg(target_os = "linux")]
 const STDIN_FILENO: libc::c_int = 0;
+#[cfg(target_os = "linux")]
 const STDOUT_FILENO: libc::c_int = 1;
+#[cfg(target_os = "linux")]
 const STDERR_FILENO: libc::c_int = 2;
 
 // Kernel-based virtual machine (hardware virtualization extensions)
@@ -84,6 +90,7 @@ const FOLDER_PERMISSIONS: u32 = 0o700;
 const PID_FILE_EXTENSION: &str = ".pid";
 
 // Helper function, since we'll use libc::dup2 a bunch of times for daemonization.
+#[cfg(target_os = "linux")] // wick: macOS's daemonize is platform::daemonize
 fn dup2(old_fd: libc::c_int, new_fd: libc::c_int) -> Result<(), JailerError> {
     // SAFETY: This is safe because we are using a library function with valid parameters.
     SyscallReturnCode(unsafe { libc::dup2(old_fd, new_fd) })
@@ -366,16 +373,16 @@ impl Env {
     }
 
     // wick: outside Linux, PID namespaces are platform::new_pid_ns (overlay/jailer/platform):
-    // macOS refuses; on Windows the jailer has handed over to a keeper (env::run), which runs
-    // Firecracker as without the flag.
-    #[cfg(not(target_os = "linux"))]
+    // on Windows the jailer has handed over to a keeper (env::run), which runs Firecracker as
+    // without the flag; macOS takes Linux's path below, with a fork in place of the clone.
+    #[cfg(windows)]
     fn exec_into_new_pid_ns(&mut self, chroot_exec_file: PathBuf) -> Result<(), JailerError> {
         crate::platform::new_pid_ns()?;
         self.save_exec_file_pid(id().try_into().unwrap(), chroot_exec_file.clone())?;
         Err(JailerError::Exec(self.exec_command(chroot_exec_file)))
     }
 
-    #[cfg(target_os = "linux")]
+    #[cfg(any(target_os = "linux", target_os = "macos"))] // wick: macOS: a fork (below)
     fn exec_into_new_pid_ns(&mut self, chroot_exec_file: PathBuf) -> Result<(), JailerError> {
         // https://man7.org/linux/man-pages/man7/pid_namespaces.7.html
         // > a process in an ancestor namespace can send signals to the "init" process of a child
@@ -412,7 +419,12 @@ impl Env {
         // Duplicate the current process. The child process will belong to the previously created
         // PID namespace. The current process will not be moved into the newly created namespace,
         // but its first child will assume the role of init(1) in the new namespace.
+        #[cfg(target_os = "linux")] // wick: macOS has no PID namespaces
         let pid = clone(std::ptr::null_mut(), libc::CLONE_NEWPID)?;
+        // wick: a child Firecracker becomes, whose jail holds what the namespace would
+        // (platform::new_pid_ns).
+        #[cfg(target_os = "macos")]
+        let pid = crate::platform::new_pid_ns()?;
         match pid {
             0 => {
                 if is_session_leader {
@@ -828,7 +840,14 @@ impl Env {
         self.jailer_cpu_time_us = get_time_us(ClockType::ProcessCpu) - self.start_time_cpu_us;
 
         // Daemonize before exec, if so required (when the dev_null variable != None).
-        #[cfg(not(windows))] // wick: refused on Windows above
+        // wick: on macOS the double fork is platform::daemonize, each fork made only
+        // while the jailer has one thread (platform::fork_alone): the child of each
+        // goes on as the whole jailer. Linux's below is upstream's, unchanged.
+        #[cfg(target_os = "macos")]
+        if let Some(dev_null) = dev_null {
+            crate::platform::daemonize(&dev_null, &mut self.jailer_cpu_time_us)?;
+        }
+        #[cfg(target_os = "linux")] // wick: refused on Windows above; macOS's is above
         if let Some(dev_null) = dev_null {
             // We follow the double fork method to daemonize the jailer referring to
             // https://0xjet.github.io/3OHA/2022/04/11/post.html
