+    /// Returns the (start, end) of the allocation containing `addr`, if any.
+    // wick: Windows has no /proc; the allocation is walked with VirtualQuery,
+    // region by region from its base, over the pages that are reserved or
+    // committed. A free address is in none.
+    #[cfg(windows)]
+    fn find_vma_containing(addr: usize) -> Option<(usize, usize)> {
+        /// `MEMORY_BASIC_INFORMATION` (64-bit); only some fields are read.
+        #[repr(C)]
+        #[derive(Default)]
+        #[allow(dead_code)]
+        struct MemoryBasicInformation {
+            base_address: usize,
+            allocation_base: usize,
+            allocation_protect: u32,
+            partition_id: u16,
+            region_size: usize,
+            state: u32,
+            protect: u32,
+            kind: u32,
+        }
+        #[link(name = "kernel32")]
+        unsafe extern "system" {
+            fn VirtualQuery(
+                address: *const std::ffi::c_void,
+                buffer: *mut MemoryBasicInformation,
+                length: usize,
+            ) -> usize;
+        }
+        const MEM_FREE: u32 = 0x10000;
+        let query = |at: usize| {
+            let mut info = MemoryBasicInformation::default();
+            // SAFETY: a valid output buffer of the given size; any address may be queried.
+            let n = unsafe {
+                VirtualQuery(
+                    at as *const std::ffi::c_void,
+                    &mut info,
+                    std::mem::size_of::<MemoryBasicInformation>(),
+                )
+            };
+            (n != 0 && info.state != MEM_FREE).then_some(info)
+        };
+        let base = query(addr)?.allocation_base;
+        let mut end = base;
+        while let Some(info) = query(end).filter(|i| i.allocation_base == base) {
+            end = info.base_address + info.region_size;
+        }
+        Some((base, end))
+    }
+
