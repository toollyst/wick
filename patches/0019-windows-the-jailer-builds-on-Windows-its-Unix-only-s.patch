 use std::io::Write;
+#[cfg(not(windows))] // wick: Windows has no file modes or owners (platform)
 use std::os::unix::fs::{MetadataExt, OpenOptionsExt, PermissionsExt, fchown};
+#[cfg(not(windows))] // wick: as above
 use std::os::unix::io::AsRawFd;
 #[cfg(target_os = "linux")] // wick: the exec as uid:gid is Linux's backend
 use std::os::unix::process::CommandExt;
@@ -500,6 +506,14 @@ impl Env {
             })
     }
 
+    // wick: on Windows a jailed folder's access is the jail's, inherited
+    // (platform::setup_jailed_folder): no mode or owner to set.
+    #[cfg(windows)]
+    fn setup_jailed_folder(&self, folder: impl AsRef<Path>) -> Result<(), JailerError> {
+        crate::platform::setup_jailed_folder(folder.as_ref())
+    }
+
+    #[cfg(not(windows))]
     fn setup_jailed_folder(&self, folder: impl AsRef<Path>) -> Result<(), JailerError> {
         let folder_path = folder.as_ref();
         fs::create_dir_all(folder_path)
@@ -521,6 +535,16 @@ impl Env {
             .ok_or_else(|| JailerError::ExtractFileName(self.exec_file_path.clone()))?;
         let jailer_exec_file_path = self.chroot_dir.join(exec_file_name);
 
+        // wick: on Windows the copy has no mode or owner; its access is the
+        // jail's (platform::copy_exec).
+        #[cfg(windows)]
+        {
+            crate::platform::copy_exec(&self.exec_file_path, &jailer_exec_file_path)?;
+            Ok(exec_file_name.to_owned())
+        }
+        #[cfg(not(windows))]
+        {
+
         // We do a copy instead of a hard-link for 2 reasons
         // 1. hard-linking is not possible if the file is in another device
         // 2. while hardlinking would save up disk space and also memory by sharing parts of the
@@ -564,6 +588,7 @@ impl Env {
         })?;
 
         Ok(exec_file_name.to_owned())
+        }
     }
 
     // wick: outside Linux, network namespaces are platform::join_netns.
@@ -725,7 +750,15 @@ impl Env {
             conf.setup()?;
         }
 
+        // wick: Windows has no fork; the jailer stays while Firecracker runs
+        // (platform::daemonize refuses).
+        #[cfg(windows)]
+        if self.daemonize {
+            crate::platform::daemonize()?;
+        }
+
         // If daemonization was requested, open /dev/null before chrooting.
+        #[cfg(not(windows))]
         let dev_null = if self.daemonize {
             Some(
                 File::open("/dev/null")
@@ -786,6 +819,7 @@ impl Env {
         self.jailer_cpu_time_us = get_time_us(ClockType::ProcessCpu) - self.start_time_cpu_us;
 
         // Daemonize before exec, if so required (when the dev_null variable != None).
+        #[cfg(not(windows))] // wick: refused on Windows above
         if let Some(dev_null) = dev_null {
             // We follow the double fork method to daemonize the jailer referring to
             // https://0xjet.github.io/3OHA/2022/04/11/post.html
