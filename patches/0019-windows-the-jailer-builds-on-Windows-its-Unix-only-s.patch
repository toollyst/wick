From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: qmfflwj <qmfflwj@gmail.com>
Date: Wed, 11 Nov 2026 00:51:21 +0900
Subject: [PATCH] windows: the jailer builds on Windows, its Unix-only steps
 through platform

The jailer's root declares wick_std as std, and its Windows backend
(overlay/jailer/platform/windows) is the cgroup and chroot module there, as
on macOS. Upstream's steps Windows has no form of go through it: a jailed
folder and the copy of the binary get the jail's access instead of a mode
and an owner, resource limits Windows cannot enforce are refused, and
--daemonize is refused (no fork; the jailer waits for Firecracker). The
resource limit tests that set and read limits are Linux's and macOS's.
---
 Cargo.lock                        |  2 ++
 src/jailer/Cargo.toml             | 17 ++++++++++++++++
 src/jailer/src/env.rs             | 34 +++++++++++++++++++++++++++++++
 src/jailer/src/main.rs            |  6 ++++++
 src/jailer/src/resource_limits.rs | 14 +++++++++++++
 5 files changed, 73 insertions(+)

diff --git a/Cargo.lock b/Cargo.lock
index 1b2ff3591a358a9aa0c514bba20a95b70a0d85f6..fc80150e0de7c4f7bcecba9bbe40b6a187583b21 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -869,7 +869,9 @@ dependencies = [
  "thiserror 2.0.20",
  "utils",
  "vmm-sys-util 0.15.0",
+ "wick-std",
  "wick-version",
+ "windows-sys",
 ]
 
 [[package]]
diff --git a/src/jailer/Cargo.toml b/src/jailer/Cargo.toml
index 1950cefd06451e668ef1db85ffce9182f2b10242..b73afb36cbb2f3f8131291611e31ee3c8a3a58bc 100644
--- a/src/jailer/Cargo.toml
+++ b/src/jailer/Cargo.toml
@@ -25,5 +25,22 @@ utils = { path = "../utils" }
 # wick: wick's release version, <upstream>[+wick.<N>] (crates/version).
 wick-version = { path = "../../../../crates/version" }
 
+# wick: std::os::{unix, fd} on Windows (`extern crate wick_std as std` at the
+# root), and the Windows backend of the jailer (overlay/jailer/platform/windows:
+# restricted tokens, the jail's ACL and drive, the Job Object).
+[target.'cfg(windows)'.dependencies]
+wick-std = { path = "../../../../crates/compat/std" }
+windows-sys = { version = "0.61.2", features = [
+    "Win32_Foundation",
+    "Win32_NetworkManagement_WindowsFilteringPlatform",
+    "Win32_Security",
+    "Win32_Security_Authorization",
+    "Win32_Storage_FileSystem",
+    "Win32_System_Console",
+    "Win32_System_JobObjects",
+    "Win32_System_Rpc",
+    "Win32_System_Threading",
+] }
+
 [lints]
 workspace = true
