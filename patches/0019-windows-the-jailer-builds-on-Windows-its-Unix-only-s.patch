+// wick: on Windows the Unix-only steps go through platform, leaving their
+// imports and helpers unused.
+#![cfg_attr(windows, allow(unused_imports, dead_code))]
+
 use std::ffi::{CStr, CString, OsString};
 use std::fs::{self, File, OpenOptions, Permissions, canonicalize, read_to_string};
