From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=EC=8B=AC=EC=83=81=EC=9B=90?= <dev.chamomile@gmail.com>
Date: Tue, 10 Nov 2026 12:34:16 +0900
Subject: [PATCH] windows: std::os::{unix, fd} from wick-std at the crate roots

Why: upstream code uses std::os::unix and std::os::fd (RawFd, AsRawFd,
UnixStream, ...), which do not exist on Windows.

What: utils, vmm and firecracker depend on wick-std on Windows and declare
`extern crate wick_std as std;` at their roots, so `std::os::{unix, fd}`
resolve to wick-os (the same traits over Windows handles) and everything
else to the real std. Other targets are unaffected.

Test: `cargo build -p firecracker --target x86_64-pc-windows-gnu`.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/firecracker/Cargo.toml  | 4 ++++
 src/firecracker/src/lib.rs  | 4 ++++
 src/firecracker/src/main.rs | 4 ++++
 src/utils/Cargo.toml        | 4 ++++
 src/utils/src/lib.rs        | 4 ++++
 src/vmm/Cargo.toml          | 4 ++++
 src/vmm/src/lib.rs          | 4 ++++
 7 files changed, 28 insertions(+)

diff --git a/src/firecracker/Cargo.toml b/src/firecracker/Cargo.toml
index 8d2806f99b0ed1fc04d5cd15a1377d4dbf1c5be5..37c2a2a3a62a03a8d755047702451e9f1bbb50cb 100644
--- a/src/firecracker/Cargo.toml
+++ b/src/firecracker/Cargo.toml
@@ -38,6 +38,10 @@ utils = { path = "../utils" }
 vmm = { path = "../vmm" }
 vmm-sys-util = { version = "0.15.0", features = ["with-serde"] }
 
+# wick: std::os::{unix, fd} on Windows (`extern crate wick_std as std` at the roots).
+[target.'cfg(windows)'.dependencies]
+wick-std = { path = "../../../../crates/compat/std" }
+
 [build-dependencies]
 seccompiler = { path = "../seccompiler" }
 serde = { version = "1.0.228" }
