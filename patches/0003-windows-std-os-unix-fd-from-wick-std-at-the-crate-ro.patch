+// wick: std::os::{unix, fd} on Windows from wick's POSIX layer.
+#[cfg(windows)]
+extern crate wick_std as std;
+
 mod api_server;
 mod api_server_adapter;
 mod generated;
diff --git a/src/utils/Cargo.toml b/src/utils/Cargo.toml
index 6a8713c09549e667f53d30e0cb5e20901bf440c1..ab16020423d4c0e857ffab51888568bfa9f951a7 100644
