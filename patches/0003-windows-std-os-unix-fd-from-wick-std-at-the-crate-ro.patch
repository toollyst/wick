--- a/src/firecracker/src/lib.rs
+++ b/src/firecracker/src/lib.rs
@@ -1,4 +1,8 @@
 // Copyright 2024 Amazon.com, Inc. or its affiliates. All Rights Reserved.
 // SPDX-License-Identifier: Apache-2.0
 
+// wick: std::os::{unix, fd} on Windows from wick's POSIX layer.
+#[cfg(windows)]
+extern crate wick_std as std;
+
 pub mod api_server;
diff --git a/src/firecracker/src/main.rs b/src/firecracker/src/main.rs
index ecb68b30b8753345a34dcf1d810d42b947d09f26..a92dbf32c7e0591a9d34513950da87d589c7bd52 100644
--- a/src/firecracker/src/main.rs
+++ b/src/firecracker/src/main.rs
