@@ -24,6 +24,8 @@ fn exit_with_code(exit_code: FcExitCode) {
     if let Err(err) = METRICS.write() {
         error_unrestricted!("Failed to write metrics while stopping: {}", err);
     }
+    // wick: what waits for a FIFO's reader goes into the FIFO (`ext::fifo`).
