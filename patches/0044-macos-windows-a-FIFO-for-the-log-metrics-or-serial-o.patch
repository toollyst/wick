     // SAFETY: Safe because we're terminating the process anyway.
     unsafe { libc::_exit(exit_code as i32) };
 }
diff --git a/src/vmm/src/utils/mod.rs b/src/vmm/src/utils/mod.rs
index decf9d1823decbd65ee2b923955b1f6a7bfbbfd5..337d261b31042c2b38a09f6aefff37930ff2fc98 100644
--- a/src/vmm/src/utils/mod.rs
+++ b/src/vmm/src/utils/mod.rs
@@ -8,7 +8,7 @@ pub mod net;
 /// Module with external libc functions
 pub mod signal;
 
-use std::fs::{File, OpenOptions};
+use std::fs::OpenOptions;
 use std::num::Wrapping;
 #[cfg(not(windows))]
 use std::os::unix::fs::OpenOptionsExt;
@@ -101,9 +101,12 @@ macro_rules! align_down {
 /// if nobody is consuming the message. Otherwise opening the FIFO with only WRITE and O_NONBLOCK
 /// will fail with ENXIO if there is no readier already attached to it.
 /// NOTE: writing to a pipe will start failing when reaching 64K of unconsumed content.
-pub fn open_file_nonblock(path: &Path) -> Result<File, std::io::Error> {
+// wick: an `OutFile`, so that a FIFO holds 64K on every host (`ext::fifo`).
+pub fn open_file_nonblock(path: &Path) -> Result<crate::ext::fifo::OutFile, std::io::Error> {
     // wick: Windows cannot open non-blocking; the file is made non-blocking
-    // once open (a pipe gets `PIPE_NOWAIT`; files never block).
+    // once open (a pipe gets `PIPE_NOWAIT`; files never block). A pipe ends
+    // with its reader, where a FIFO held read-write does not: what it does
+    // not take waits in the process, for that reader or the next.
     #[cfg(windows)]
     {
         use std::os::fd::AsRawFd;
@@ -116,15 +119,20 @@ pub fn open_file_nonblock(path: &Path) -> Result<File, std::io::Error> {
         if unsafe { libc::fcntl(file.as_raw_fd(), libc::F_SETFL, O_NONBLOCK) } < 0 {
             return Err(std::io::Error::last_os_error());
         }
-        return Ok(file);
+        return crate::ext::fifo::OutFile::opened(file, path);
     }
     #[cfg(not(windows))]
-    OpenOptions::new()
+    let file = OpenOptions::new()
         .custom_flags(O_NONBLOCK)
         .create(true)
         .read(true)
         .write(true)
-        .open(path)
+        .open(path)?;
+    // wick: macOS's FIFO buffer is 8K: what does not fit waits in the process.
+    #[cfg(target_os = "macos")]
+    return crate::ext::fifo::OutFile::opened(file, path);
+    #[cfg(not(any(windows, target_os = "macos")))]
+    Ok(file)
 }
 
