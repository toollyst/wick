 pub fn multi_region_mem_raw(regions: &[(GuestAddress, usize)]) -> Vec<GuestRegionMmap> {
-    memory::anonymous(regions.iter().copied(), false, HugePageConfig::None)
-        .expect("Cannot initialize memory")
+    // wick: these regions are registered with the hypervisor, which maps whole host pages
+    // (16 KiB on Apple silicon, as with KVM on a 16 KiB-page kernel). Sizes in whole guest
+    // pages are rounded up to host pages; other sizes are kept, so they are still rejected.
+    let page = crate::arch::host_page_size();
+    let regions = regions.iter().map(|&(addr, size)| {
+        if size.is_multiple_of(crate::arch::GUEST_PAGE_SIZE) {
+            (addr, size.next_multiple_of(page))
+        } else {
+            (addr, size)
+        }
+    });
+    memory::anonymous(regions, false, HugePageConfig::None).expect("Cannot initialize memory")
 }
 
