 use super::MAX_PAGE_COMPACT_BUFFER;
 use crate::logger::error;
 
+/// wick: the part of the byte range `[addr, addr + len)` to release. Memory can only be
+/// released in host pages (16 KiB on Apple silicon and some Arm servers, while balloon pages
+/// are 4 KiB): a range of whole balloon pages is trimmed to the whole host pages in it (`None`
+/// if there are none; the rest stays in place). Other ranges are returned unchanged, so that
+/// releasing them fails as before.
+pub(crate) fn whole_host_pages(addr: u64, len: u64, host_page: u64) -> Option<(u64, u64)> {
+    const BALLOON_PAGE: u64 = 1 << super::VIRTIO_BALLOON_PFN_SHIFT;
+    if !addr.is_multiple_of(BALLOON_PAGE) || !len.is_multiple_of(BALLOON_PAGE) {
+        return Some((addr, len));
+    }
+    let start = addr.checked_next_multiple_of(host_page)?;
+    let end = addr.checked_add(len)? / host_page * host_page;
+    (start < end).then(|| (start, end - start))
+}
+
 /// This takes a vector of page frame numbers, and compacts them
 /// into ranges of consecutive pages. The result is a vector
 /// of (start_page_frame_number, range_length) pairs.
@@ -67,6 +82,34 @@ mod tests {
 
     use super::*;
 
+    #[test]
+    fn test_whole_host_pages() {
+        // 4 KiB host pages: ranges are kept as they are.
+        assert_eq!(
+            whole_host_pages(0x1000, 0x1000, 0x1000),
+            Some((0x1000, 0x1000))
+        );
+        // 16 KiB host pages: only whole host pages are released.
+        assert_eq!(whole_host_pages(0x1000, 0x1000, 0x4000), None);
+        assert_eq!(
+            whole_host_pages(0x4000, 0x4000, 0x4000),
+            Some((0x4000, 0x4000))
+        );
+        assert_eq!(
+            whole_host_pages(0x3000, 0x9000, 0x4000),
+            Some((0x4000, 0x8000))
+        );
+        assert_eq!(
+            whole_host_pages(0xffff_ffff_ffff_e000, 0x2000, 0x4000),
+            None
+        );
+        // Ranges that are not whole balloon pages are left alone.
+        assert_eq!(
+            whole_host_pages(0x1001, 0x1000, 0x4000),
+            Some((0x1001, 0x1000))
+        );
+    }
