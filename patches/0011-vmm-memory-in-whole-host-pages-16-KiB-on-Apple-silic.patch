+    fn find_vma_containing(addr: usize) -> Option<(usize, usize)> {
+        unsafe extern "C" {
+            fn mach_vm_region(
+                task: libc::mach_port_t,
+                address: *mut u64,
+                size: *mut u64,
+                flavor: libc::c_int,
+                info: *mut libc::c_int,
+                count: *mut u32,
+                object_name: *mut libc::mach_port_t,
+            ) -> libc::c_int;
+            static mach_task_self_: libc::mach_port_t;
+        }
+        const VM_REGION_BASIC_INFO_64: libc::c_int = 9;
+        let mut start = addr as u64;
+        let mut size = 0u64;
+        let mut info = [0 as libc::c_int; 16];
+        let mut count = 9u32;
+        let mut object = 0;
+        // SAFETY: valid output buffers; `info` is larger than the basic info.
+        let ret = unsafe {
+            mach_vm_region(
+                mach_task_self_,
+                &mut start,
+                &mut size,
+                VM_REGION_BASIC_INFO_64,
+                info.as_mut_ptr(),
+                &mut count,
+                &mut object,
+            )
+        };
+        // The call returns the first entry at or after `addr`.
+        let (start, end) = (
+            usize::try_from(start).ok()?,
+            usize::try_from(start + size).ok()?,
+        );
+        (ret == 0 && start <= addr && addr < end).then_some((start, end))
+    }
