-#[cfg(target_arch = "x86_64")]
+// wick: Windows has no sysfs; the DMI files the fingerprint reads are the
+// SMBIOS values Windows keeps in the registry (HARDWARE\DESCRIPTION\System\BIOS),
+// in Linux's format. Any other path is not found, as on Linux.
+#[cfg(windows)]
+fn read_sysfs_file(path: &str) -> Result<String, FingerprintDumpError> {
+    const BIOS: &str = r"HARDWARE\DESCRIPTION\System\BIOS";
+    let value = match path {
+        "/sys/devices/virtual/dmi/id/bios_version" => {
+            registry::string(BIOS, "BIOSVersion")
+        }
+        "/sys/devices/virtual/dmi/id/bios_release" => registry::dword(BIOS, "BiosMajorRelease")
+            .and_then(|major| {
+                registry::dword(BIOS, "BiosMinorRelease").map(|minor| format!("{major}.{minor}"))
+            }),
+        _ => Err(std::io::ErrorKind::NotFound.into()),
+    };
+    value.map_err(|err| FingerprintDumpError::ReadSysfsFile(path.to_string(), err))
+}
+
+#[cfg(all(target_arch = "x86_64", windows))]
+fn get_microcode_version() -> Result<String, FingerprintDumpError> {
+    // wick: the revision Windows read from the processor at boot, as Linux's
+    // /proc/cpuinfo shows it: Intel's in the high half of the 8-byte value,
+    // AMD's the whole 4-byte one.
+    let bytes = registry::binary(r"HARDWARE\DESCRIPTION\System\CentralProcessor\0", "Update Revision")
+        .map_err(FingerprintDumpError::ReadProcCpuinfo)?;
+    let revision = match bytes.len() {
+        8 => u32::from_le_bytes(bytes[4..8].try_into().unwrap()),
+        4 => u32::from_le_bytes(bytes[..4].try_into().unwrap()),
+        _ => return Err(FingerprintDumpError::MicrocodeVersionNotFound),
+    };
+    Ok(format!("{revision:#x}"))
+}
+
+// wick: values under HKEY_LOCAL_MACHINE.
+#[cfg(windows)]
+mod registry {
+    use std::io;
+
+    use windows_sys::Win32::System::Registry::{
+        HKEY_LOCAL_MACHINE, RRF_RT_REG_BINARY, RRF_RT_REG_DWORD, RRF_RT_REG_SZ, RegGetValueW,
+    };
+
+    fn wide(s: &str) -> Vec<u16> {
+        s.encode_utf16().chain(std::iter::once(0)).collect()
+    }
+
+    fn get(key: &str, value: &str, kind: u32) -> io::Result<Vec<u8>> {
+        let (key, value) = (wide(key), wide(value));
+        let mut buf = vec![0u8; 512];
+        let mut len = u32::try_from(buf.len()).unwrap();
+        // SAFETY: NUL-terminated names; a buffer of the length passed.
+        let rc = unsafe {
+            RegGetValueW(
+                HKEY_LOCAL_MACHINE,
+                key.as_ptr(),
+                value.as_ptr(),
+                kind,
+                std::ptr::null_mut(),
+                buf.as_mut_ptr().cast(),
+                &mut len,
+            )
+        };
+        if rc != 0 {
+            return Err(io::Error::from_raw_os_error(i32::try_from(rc).unwrap()));
+        }
+        buf.truncate(len as usize);
+        Ok(buf)
+    }
+
+    pub fn string(key: &str, value: &str) -> io::Result<String> {
+        let b = get(key, value, RRF_RT_REG_SZ)?;
+        let units: Vec<u16> = b.chunks_exact(2).map(|c| u16::from_le_bytes([c[0], c[1]])).collect();
+        Ok(String::from_utf16_lossy(&units).trim_end_matches('\0').trim().to_string())
+    }
+
+    pub fn dword(key: &str, value: &str) -> io::Result<u32> {
+        let b = get(key, value, RRF_RT_REG_DWORD)?;
+        Ok(u32::from_le_bytes(b[..4].try_into().unwrap()))
+    }
+
+    pub fn binary(key: &str, value: &str) -> io::Result<Vec<u8>> {
+        get(key, value, RRF_RT_REG_BINARY)
+    }
+}
+
