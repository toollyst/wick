 src/vmm/src/arch/aarch64/cache_info.rs | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/vmm/src/arch/aarch64/cache_info.rs b/src/vmm/src/arch/aarch64/cache_info.rs
index 4c934626f1b548a848341c1690f7e10369699431..995c1c74d25167f16108cdd9a05fab0ff5d033ed 100644
--- a/src/vmm/src/arch/aarch64/cache_info.rs
+++ b/src/vmm/src/arch/aarch64/cache_info.rs
@@ -2,6 +2,8 @@
 // SPDX-License-Identifier: Apache-2.0
 
 use std::path::{Path, PathBuf};
+// wick: fs is not used on macOS (readln_special).
+#[cfg_attr(target_os = "macos", allow(unused_imports))]
 use std::{fs, io};
 
 use crate::logger::warn;
@@ -207,12 +209,22 @@ impl CacheType {
     }
 }
 
+#[cfg(not(target_os = "macos"))]
 #[cfg_attr(test, allow(unused))]
 fn readln_special<T: AsRef<Path>>(file_path: &T) -> Result<String, CacheInfoError> {
     let line = fs::read_to_string(file_path)?;
     Ok(line.trim_end().to_string())
 }
 
+// wick: macOS has no sysfs; the host's caches are read from XNU and
+// Hypervisor.framework, in sysfs's format (ext::sysfs).
+#[cfg(target_os = "macos")]
+#[cfg_attr(test, allow(unused))]
+fn readln_special<T: AsRef<Path>>(file_path: &T) -> Result<String, CacheInfoError> {
+    let path = file_path.as_ref().to_string_lossy();
+    Ok(crate::ext::sysfs::read(&path)?.trim_end().to_string())
+}
+
