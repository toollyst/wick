From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=EC=8B=AC=EC=83=81=EC=9B=90?= <dev.chamomile@gmail.com>
Date: Tue, 10 Nov 2026 12:34:19 +0900
Subject: [PATCH] utils, vmm: host APIs that differ outside glibc/Linux

Why: a few call sites assume glibc or Linux behaviour that has a direct
equivalent elsewhere.

What: `tm_zone` initialisation that does not assume glibc's layout; the
timerfd is read through libc on Windows; SIGRTMIN/SIGRTMAX without glibc;
`open_file_nonblock` on Windows; read-only pmem files are mapped privately
on macOS (Hypervisor.framework cannot map shared memory of a file
opened read-only; a read-only device is never written, so a private
mapping holds the same bytes).

The files Firecracker opens for reading by a path the operator gave (the
kernel image, the initrd, a snapshot's state and memory files, a seccomp
filter file) are opened with OpenOptions::new().read(true), which is what
File::open is. On Windows OpenOptions is wick's (crates/compat/std): a
path may name a pipe, whose maker could act as the client that opens it,
so it opens at the anonymous impersonation level, and it counts against
the jail's no-file limit, where File::open, std's own, does neither.
Nothing changes on Linux or macOS.

Test: utils and vmm unit tests on each host.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/firecracker/src/main.rs               |  5 +++--
 src/firecracker/src/seccomp.rs            |  3 ++-
 src/utils/src/time.rs                     | 20 ++++++++++++++++++--
 src/vmm/src/devices/virtio/pmem/device.rs | 12 ++++++++++--
 src/vmm/src/persist.rs                    |  8 +++++---
 src/vmm/src/utils/mod.rs                  | 18 ++++++++++++++++++
 src/vmm/src/utils/signal.rs               | 12 ++++++++++--
 src/vmm/src/vmm_config/boot_source.rs     |  6 ++++--
 8 files changed, 70 insertions(+), 14 deletions(-)

diff --git a/src/firecracker/src/main.rs b/src/firecracker/src/main.rs
index a92dbf32c7e0591a9d34513950da87d589c7bd52..5f3b97595f79f8cd2f4d5dfb0b8e3cc96b99bc39 100644
--- a/src/firecracker/src/main.rs
+++ b/src/firecracker/src/main.rs
@@ -17,7 +17,7 @@ mod generated;
 mod metrics;
 mod seccomp;
 
-use std::fs::{self, File};
+use std::fs;
 use std::path::PathBuf;
 use std::process::ExitCode;
 use std::str::FromStr;
@@ -572,7 +572,8 @@ enum SnapshotVersionError {
 // Print data format of provided snapshot state file.
 fn print_snapshot_data_format(snapshot_path: &str) -> Result<(), SnapshotVersionError> {
     let mut snapshot_reader =
-        File::open(snapshot_path).map_err(SnapshotVersionError::OpenSnapshot)?;
+        // wick: through `OpenOptions`, which is wick's on Windows (a path may name a pipe).
+        fs::OpenOptions::new().read(true).open(snapshot_path).map_err(SnapshotVersionError::OpenSnapshot)?;
 
     let data_format_version =
         get_format_version(&mut snapshot_reader).map_err(SnapshotVersionError::SnapshotVersion)?;
diff --git a/src/firecracker/src/seccomp.rs b/src/firecracker/src/seccomp.rs
index f073641bb1dcfa68213585e241b917be9b9f351d..a217349e667979aef96b9bfd54b56d2c2d513407 100644
--- a/src/firecracker/src/seccomp.rs
+++ b/src/firecracker/src/seccomp.rs
@@ -46,7 +46,8 @@ impl SeccompConfig {
         } else {
             match seccomp_filter {
                 Some(path) => Ok(SeccompConfig::Custom(
-                    File::open(path).map_err(FilterError::FileOpen)?,
