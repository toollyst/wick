From: =?UTF-8?q?=EC=8B=AC=EC=83=81=EC=9B=90?= <dev.chamomile@gmail.com>
Date: Thu, 12 Nov 2026 01:45:50 +0900
Subject: [PATCH] wick: the huge-page region test runs on macOS, where a huge
 page is host pages

free_hugepages_2m reads /proc/meminfo on Linux; on Windows and now on
macOS it maps one 2 MiB page, which the compatibility libc gives from
free memory (2 MiB aligned host pages on macOS, which has no superpage
for user space).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/vmm/src/vstate/memory.rs | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/src/vmm/src/vstate/memory.rs b/src/vmm/src/vstate/memory.rs
index c8734513bbb4e99e6c4897c0d32c5656b07eeca3..851f73e7223ff636d8c0babc54b8c7fc4f78fb48 100644
--- a/src/vmm/src/vstate/memory.rs
+++ b/src/vmm/src/vstate/memory.rs
@@ -2484,8 +2484,10 @@ mod tests {
     /// Returns the number of free 2 MiB hugepages on the system.
     // wick: Windows has no /proc/meminfo and no huge page pool: large pages
     // come from free memory to an account that holds "Lock pages in memory".
-    // One 2 MiB large page is free when mapping one succeeds.
-    #[cfg(windows)]
+    // macOS has no pool either: a huge page mapping is host pages, 2 MiB
+    // aligned (the compatibility libc). One 2 MiB page is free when mapping
+    // one succeeds.
+    #[cfg(not(target_os = "linux"))]
     fn free_hugepages_2m() -> usize {
         let len = mib_to_bytes(2);
         // SAFETY: a new anonymous mapping, unmapped below.
@@ -2508,7 +2510,8 @@ mod tests {
     }
 
     /// Returns the number of free 2 MiB hugepages on the system.
-    #[cfg(not(windows))]
+    // wick: Linux reads the pool; the other hosts map a page (above).
+    #[cfg(target_os = "linux")]
     fn free_hugepages_2m() -> usize {
         let meminfo = std::fs::read_to_string("/proc/meminfo").unwrap_or_default();
         meminfo
