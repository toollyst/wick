"""util-linux's `blkid` as upstream's framework uses it, which macOS lacks.

framework/utils_drive.py reads a DOS-labelled disk image's partition table
id with `blkid -s PTUUID -o value <file>`: for a DOS label, its disk
identifier (MBR bytes 440 to 443, little-endian) as 8 lowercase hex digits,
of which Linux makes each partition's PARTUUID (`<PTUUID>-01`). A file with
no DOS label prints nothing and exits 2, as blkid does when it finds no tag.
Any other use is refused.
"""
import struct
import sys

args = sys.argv[1:]
if len(args) != 5 or args[:4] != ["-s", "PTUUID", "-o", "value"]:
    sys.exit(f"blkid (wick macOS shim): only `blkid -s PTUUID -o value <file>` is supported, not {args}")
with open(args[4], "rb") as f:
    mbr = f.read(512)
# A protective MBR (type 0xee) is GPT's, whose PTUUID is its GUID: not here.
if len(mbr) < 512 or mbr[510:512] != b"\x55\xaa" or mbr[450] == 0xEE:
    sys.exit(2)
print(f"{struct.unpack('<I', mbr[440:444])[0]:08x}")
