#!/bin/sh
# Copyright 2026 toollyst contributors.
# SPDX-License-Identifier: Apache-2.0
# util-linux's losetup, as upstream's tests call it (test_drive_virtio.py's
# test_rescan_dev): `losetup --find --show FILE` makes a block device of a
# file and prints its node, `losetup --detach DEV` removes it.
#
# macOS: a disk image attached without mounting it (hdiutil attach -nomount,
# as a raw image, CRawDiskImage: the file's bytes are the disk's, as a loop
# device's are). Its /dev/diskN is the user's who attached it (measured:
# brw-r----- <user> staff), so the user opens it read-write, where Linux's
# loop devices need root. Its size is the file's.
#
# --detach of a device still open (test_rescan_dev's Firecracker holds it):
# Linux returns 0 and destroys the device on its last close (losetup(8),
# util-linux, --detach: since Linux 3.7 "lazy device destruction", the
# device "marked by autoclear flag and destroyed later"; drivers/block/loop.c
# loop_clr_fd sets LO_FLAGS_AUTOCLEAR and returns 0 while disk_openers > 1,
# and lo_release tears the device down on the last close). hdiutil refuses a
# disk in use, also with -force (measured: "couldn't eject", exit 16, EBUSY),
# so a busy disk is detached by a waiter that retries until the last close,
# and --detach returns 0 as Linux's does. The waiter detaches the disk only
# while it is still the same image (a /dev/diskN number is reused once
# detached), and gives up when the disk or the session is gone; the
# session's end (detach-session-disks.sh) detaches what is still attached.
set -eu
die() { echo "losetup (wick, macOS): $*" >&2; exit 1; }
# The image attached as DEV, or nothing.
image_of() {
    hdiutil info 2>/dev/null | awk -v dev="$1" '
        /^image-path/ { sub(/^image-path *: /, ""); image = $0 }
        $1 == dev { print image; exit }'
}
case "${1:-}" in
--find)
    [ "$#" -eq 3 ] && [ "$2" = --show ] || die "only --find --show FILE and --detach DEV are supported"
    [ -f "$3" ] || die "$3: not a file"
    out="$(hdiutil attach -nomount -imagekey diskimage-class=CRawDiskImage "$3" 2>/dev/null)" ||
        die "hdiutil attach $3 failed"
    dev="$(printf '%s\n' "$out" | awk 'NR == 1 { print $1 }')"
    case "$dev" in /dev/disk*) ;; *) die "hdiutil attach $3: no device in '$out'" ;; esac
    # Recorded for the session's end (integration-tests.sh), which detaches
    # what a failed test left attached.
    [ -n "${WICK_IT_ROOT:-}" ] && mkdir -p "$WICK_IT_ROOT/.attached" && : >"$WICK_IT_ROOT/.attached/${dev#/dev/}"
    echo "$dev"
    ;;
--detach | -d)
    [ "$#" -eq 2 ] || die "--detach DEV"
    dev="$2"
    record="${WICK_IT_ROOT:+$WICK_IT_ROOT/.attached/${dev#/dev/}}"
    image="$(image_of "$dev")"
    [ -n "$image" ] || die "$dev: not an attached disk image"
    rc=0
    hdiutil detach "$dev" >/dev/null 2>&1 || rc=$?
    if [ "$rc" -eq 0 ]; then
        [ -n "$record" ] && rm -f "$record"
        exit 0
    fi
    [ "$rc" -eq 16 ] || die "hdiutil detach $dev failed ($rc)"
    # In use: detached on its last close. The waiter names the session in
    # its command line, so that tools/clean.sh leaves it while the session
    # lives and stops it after. The image's path is given in its environment,
    # not its command line: the path is in the jail, whose id upstream's
    # framework looks for in every command line once it killed Firecracker
    # (microvm.py kill: "processes using the supposedly dead Firecracker's
    # jailer_id"), and a waiter is no Firecracker process.
    # shellcheck disable=SC2016 # the waiter's script expands its own arguments
    WICK_LOSETUP_IMAGE="$image" nohup /bin/sh -c '
        dev=$1 image=$WICK_LOSETUP_IMAGE record=$2 session=$3
        while [ -z "$session" ] || [ -d "$session" ]; do
            now="$(hdiutil info 2>/dev/null | awk -v dev="$dev" "
                /^image-path/ { sub(/^image-path *: /, \"\"); image = \$0 }
                \$1 == dev { print image; exit }")"
            [ "$now" = "$image" ] || exit 0
            if hdiutil detach "$dev" >/dev/null 2>&1; then
                [ -n "$record" ] && rm -f "$record"
                exit 0
            fi
            sleep 1
        done' losetup-lazy-detach "$dev" "$record" "${WICK_IT_ROOT:-}" </dev/null >/dev/null 2>&1 &
    exit 0
    ;;
*) die "only --find --show FILE and --detach DEV are supported, not '$*'" ;;
esac
