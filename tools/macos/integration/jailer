"""The jailer's stand-in for tools/macos/integration-tests.sh's user mode.

Upstream's framework starts every microVM through the jailer, which needs
root. In user mode this script takes the jailer's place: it starts
Firecracker from a copy in the jail (copy_exec) as the jailer's process tree does (`--daemonize`'s double fork
and new session, `--new-pid-ns`'s child whose pid goes to `<exec>.pid` while
the launcher exits 0, `--resource-limit`, `--netns`'s network), with the jail's directory as the
root of every path Firecracker is given on its command line and in its
configuration file, and as its working directory. The paths of the
configuration file are given relative to that directory (`.//<path>`, as
tools/macos/integration/wick_macos.py gives those of API requests): a
snapshot keeps them, and a microVM restored in another jail resolves them
in its own jail, as it does in a chroot. What needs root (chroot,
the jail's uid and gid, cgroups) is the jailer's own and is tested in the
`jailer` mode; asking for a cgroup here fails, as a jailer that cannot set one
does.
"""

import ctypes
import errno
import fcntl
import json
import os
import resource
import sys
import time

# Firecracker options whose value is a path in the jail.
PATH_OPTIONS = {"--api-sock", "--log-path", "--metrics-path", "--config-file", "--metadata",
                "--seccomp-filter"}
CONFIG_PATH_FIELDS = {"kernel_image_path", "initrd_path", "path_on_host", "socket", "uds_path",
                      "log_path", "metrics_path", "serial_out_path"}


def die(msg):
    print(f"jailer (wick user-mode stand-in): {msg}", file=sys.stderr)
    sys.exit(1)


def parse(argv):
    opts = {"cgroup": [], "resource-limit": []}
    flags = set()
    rest = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            rest = argv[i + 1 :]
            break
        if not a.startswith("--"):
            die(f"unexpected argument {a}")
        name = a[2:]
        if name in ("daemonize", "new-pid-ns"):
            flags.add(name)
            i += 1
            continue
        if i + 1 >= len(argv):
            die(f"{a} needs a value")
        if name in opts and isinstance(opts[name], list):
            opts[name].append(argv[i + 1])
        else:
            opts[name] = argv[i + 1]
        i += 2
    for req in ("id", "exec-file", "uid", "gid"):
        if req not in opts:
            die(f"missing --{req}")
    return opts, flags, rest


def in_jail(root, path):
    return root + path if path.startswith("/") else path


def translate_config(root, path):
    # Relative, the path is the jail's too: Firecracker runs in the jail's
    # directory, as after the jailer's chroot.
    host = in_jail(root, path) if path.startswith("/") else os.path.join(root, path)
    with open(host, encoding="utf-8") as f:
        cfg = json.load(f)

    def walk(v, key=None):
        if isinstance(v, dict):
            return {k: walk(x, k) for k, x in v.items()}
        if isinstance(v, list):
            return [walk(x, key) for x in v]
        if key in CONFIG_PATH_FIELDS and isinstance(v, str) and v.startswith("/"):
            return ".//" + v.lstrip("/")
        return v

    out = os.path.join(os.path.dirname(host), ".wick-user-" + os.path.basename(host))
    with open(out, "w", encoding="utf-8") as f:
        json.dump(walk(cfg), f)
    return out


def join_netns(path):
    """As the jailer's --netns: the network's directory, which must exist,
    by its real path, given to Firecracker in WICK_NETNS
    (vmm::ext::jail::netns; the jailer's join_netns)."""
    real = os.path.realpath(path)
    if not os.path.isdir(real):
        die(f"The jail's network {real!r} (--netns): a network is a directory of endpoints")
    os.environ["WICK_NETNS"] = real


_libc = ctypes.CDLL(None, use_errno=True)
F_NOCACHE = 48


def copy_exec(src, dst):
    """The jailer's copy of Firecracker into the jail (env.rs
    copy_exec_to_chroot: a copy, not a link, so that two Firecrackers share
    no memory), made so that the copy has no page in the buffer cache.

    Upstream's memory monitor (host_tools/memory.py) counts what each
    mapping has resident. Linux counts the pages the process mapped (smaps
    Rss: present page-table entries, fs/proc/task_mmu.c smaps_pte_entry).
    macOS counts the pages of the mapped file resident in the buffer cache
    (proc_pidinfo PROC_PIDREGIONINFO, XNU osfmk/vm/bsd_vm.c
    fill_procregioninfo -> vm_map_region_walk -> vm_map_region_look_for_page:
    vm_page_lookup in the file's object), whoever brought them in. A
    binary every Firecracker of the session runs counted the code all of
    them ran, and a copy written through the cache counts all of it
    (measured, idle Firecracker: its binary's mappings 1.1 MiB from a clone,
    3.8 MiB after the binary was read). A clone (clonefile(2), APFS) is a
    new file whose pages are not resident; where the jail is on another
    volume, the copy is written past the cache (F_NOCACHE)."""
    if _libc.clonefile(os.fsencode(src), os.fsencode(dst), 0) == 0:
        return
    err = ctypes.get_errno()
    if err not in (errno.EXDEV, errno.ENOTSUP):
        die(f"clonefile {src} {dst}: {os.strerror(err)}")
    fd_in = os.open(src, os.O_RDONLY)
    fd_out = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o755)
    try:
        fcntl.fcntl(fd_in, F_NOCACHE, 1)
        fcntl.fcntl(fd_out, F_NOCACHE, 1)
        while chunk := os.read(fd_in, 1 << 20):
            os.write(fd_out, chunk)
        os.fchmod(fd_out, os.fstat(fd_in).st_mode & 0o7777)
        os.fsync(fd_out)
    finally:
        os.close(fd_in)
        os.close(fd_out)


def main():
    opts, flags, fc_args = parse(sys.argv[1:])
    if opts["cgroup"] or "parent-cgroup" in opts or "cgroup-version" in opts:
        die("cgroups need the jailer, as root (tools/macos/integration-tests.sh --jailer)")
    exec_file = opts["exec-file"]
    base = opts.get("chroot-base-dir", "/srv/jailer")
    root = os.path.join(base, os.path.basename(exec_file), opts["id"], "root")
    for d in ("", "/dev", "/dev/net", "/run"):
        os.makedirs(root + d, exist_ok=True)

    if "netns" in opts:
        join_netns(opts["netns"])

    for limit in opts["resource-limit"]:
        name, _, value = limit.partition("=")
        which = {"fsize": resource.RLIMIT_FSIZE, "no-file": resource.RLIMIT_NOFILE}.get(name)
        if which is None or not value.isdigit():
            die(f"invalid resource limit {limit}")
        resource.setrlimit(which, (int(value), int(value)))

    args = []
    has_api = False
    i = 0
    while i < len(fc_args):
        a = fc_args[i]
        if a in PATH_OPTIONS and i + 1 < len(fc_args):
            value = fc_args[i + 1]
            if a == "--api-sock":
                has_api = True
            value = translate_config(root, value) if a == "--config-file" else in_jail(root, value)
            args += [a, value]
            i += 2
            continue
        if a == "--no-api":
            has_api = True
        args.append(a)
        i += 1
    if not has_api:
        # Firecracker's default, /run/firecracker.socket, in the jail.
        args = ["--api-sock", root + "/run/firecracker.socket"] + args

    jailed_exec = os.path.join(root, os.path.basename(exec_file))
    if os.path.lexists(jailed_exec):
        os.unlink(jailed_exec)
    copy_exec(exec_file, jailed_exec)
    exec_file = jailed_exec

    start_us = time.time_ns() // 1000
    cpu_us = time.process_time_ns() // 1000
    argv = [exec_file, "--id", opts["id"], "--start-time-us", str(start_us),
            "--start-time-cpu-us", str(cpu_us), "--parent-cpu-time-us", "0"] + args
    os.chdir(root)
    pid_file = os.path.join(root, os.path.basename(exec_file) + ".pid")

    if "daemonize" in flags:
        null = os.open("/dev/null", os.O_RDWR)
        if os.fork():
            os._exit(0)
        os.setsid()
        if os.fork():
            os._exit(0)
        for fd in (0, 1, 2):
            os.dup2(null, fd)

    if "new-pid-ns" in flags:
        leader = "daemonize" not in flags and os.getsid(0) == os.getpid()
        pid = os.fork()
        if pid == 0:
            if leader:
                os.setsid()
            os.execv(exec_file, argv)
        with open(pid_file, "x", encoding="ascii") as f:
            f.write(str(pid))
        os._exit(0)
    with open(pid_file, "x", encoding="ascii") as f:
        f.write(str(os.getpid()))
    os.execv(exec_file, argv)


if __name__ == "__main__":
    main()
